Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"rc2", "[", 
    RowBox[{"\[Phi]_", ",", "\[Xi]_"}], "]"}], "=", 
   RowBox[{"Re", "[", 
    RowBox[{
     RowBox[{"rD\[Xi]", "[", "\[Xi]", "]"}], "-", 
     FractionBox[
      RowBox[{"2", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"rD\[Xi]", "[", "\[Xi]", "]"}], "-", 
         RowBox[{"rf\[Xi]", "[", "\[Xi]", "]"}]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"rD\[Xi]", "[", "\[Xi]", "]"}], "-", 
         RowBox[{"r4\[Xi]", "[", "\[Xi]", "]"}]}], ")"}]}], 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"rf\[Xi]", "[", "\[Xi]", "]"}], "-", 
          RowBox[{"r4\[Xi]", "[", "\[Xi]", "]"}]}], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{"Cosh", "[", 
          RowBox[{
           RowBox[{"\[Kappa]c", "[", "\[Xi]", "]"}], "*", "\[Phi]"}], "]"}], 
         ")"}]}], "+", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "*", 
          RowBox[{"rD\[Xi]", "[", "\[Xi]", "]"}]}], "-", 
         RowBox[{"rf\[Xi]", "[", "\[Xi]", "]"}], "-", 
         RowBox[{"r4\[Xi]", "[", "\[Xi]", "]"}]}], ")"}]}]]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.983204075618659*^9, 3.983204087351329*^9}}],

