        RowBox[{"2", "*", 
         RowBox[{
          RowBox[{"EllipticF", "[", 
           RowBox[{"psi", ",", "k2"}], "]"}], "/", "sqrtA"}]}]}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Funci\[OAcute]n", " ", "para", " ", "calcular", " ", "datos", " ", 
