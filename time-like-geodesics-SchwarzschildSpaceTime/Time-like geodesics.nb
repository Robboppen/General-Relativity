        RowBox[{"mu", "=", 
         RowBox[{"CalcMu", "[", 
          RowBox[{"M", ",", "l"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"A", "=", 
         RowBox[{"CalcA", "[", 
          RowBox[{"mu", ",", "e"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"k2", "=", 
