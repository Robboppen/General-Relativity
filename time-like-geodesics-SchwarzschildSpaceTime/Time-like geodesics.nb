   RowBox[{
    RowBox[{
     RowBox[{"Calck2", "[", 
      RowBox[{"mu_", ",", "e_", ",", "A_"}], "]"}], ":=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"A", "!=", "0"}], ",", 
       RowBox[{"4", "*", "mu", "*", 
        RowBox[{"e", "/", "A"}]}], ",", "1.0"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
      "Funci\[OAcute]n", " ", "para", " ", "calcular", " ", "\[CurlyPhi]", 
       RowBox[{"(", "\[Chi]", ")"}], " ", "usando", " ", "la", " ", 
       "ecuaci\[OAcute]n", " ", 
       RowBox[{"(", "132", ")"}]}], ":", "\[CurlyPhi]"}], "=", 
     RowBox[{
      RowBox[{"2", "/", 
       RowBox[{"\[Sqrt]", "A"}]}], "*", "F", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Pi]", "/", "2"}], "-", 
